{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "misi3m-sales",
  "account_id": "6a599862caf55da7c2e2adc71cf3f5b8",
  "compatibility_date": "2026-10-28",
  // dist/index.html ialah salinan misi-pemulihan-3m-sales-page.html yang ditulis oleh tools/build.mjs.
  // Static Assets abaikan Range (balas 200 penuh) dan Safari iPhone enggan main video begitu, jadi hanya .mp4
  // melalui worker/index.js yang menjawab 206. Halaman dan gambar terus dari assets tanpa Worker.
  "main": "./worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/assets/img/*.mp4"] }
}
